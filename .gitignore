# LaTeX build products
*.aux
*.bbl
*.blg
*.fdb_latexmk
*.fls
*.log
*.out
*.synctex.gz
*.toc

# Python environments and caches
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.venv/
venv/

# The numerical engine uses the declared PyPI dependency instead
code/_vendor/

# Empirical inputs are restricted and never committed.  Only schemas,
# aggregate disclosure-safe outputs, and reproducible code belong in Git.
empirical/data/
empirical/private/
empirical/output/figures/*
empirical/output/tables/*
!empirical/output/figures/.gitkeep
!empirical/output/tables/.gitkeep

# Editors and operating systems
.DS_Store
*.swp
*~
